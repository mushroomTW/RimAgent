# RimAgent 與 RimLLM Framework 共用的程式碼風格設定。
# 兩個儲存庫的此檔案內容須保持一致，修改時請同步。
# 規則嚴重性一律以 dotnet_diagnostic.<ID>.severity 指定，
# 因為選項尾端的「:severity」寫法只有 IDE 會讀，建置（EnforceCodeStyleInBuild）不會採用。
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
# 工作目錄一律 CRLF，與 .gitattributes 的 eol=crlf 一致；儲存庫內仍存 LF
end_of_line = crlf

[*.{xml,csproj,slnx,props,targets}]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Markdown 行尾雙空格具有語法意義（強制換行），不自動修剪
trim_trailing_whitespace = false

[*.cs]
#### 格式 ####
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true

#### 大括號 ####
# 慣例允許單行守衛子句不加大括號，多行才提示加大括號
csharp_prefer_braces = when_multiline
dotnet_diagnostic.IDE0011.severity = suggestion

#### var ####
# var 與明確型別都可接受，不提示
dotnet_diagnostic.IDE0007.severity = none
dotnet_diagnostic.IDE0008.severity = none

#### 現代 C# 語法偏好（.NET 10／C# 14） ####
# 檔案範圍命名空間
csharp_style_namespace_declarations = file_scoped
dotnet_diagnostic.IDE0161.severity = warning

# 型別明顯時使用目標型別 new()
csharp_style_implicit_object_creation_when_type_is_apparent = true
dotnet_diagnostic.IDE0090.severity = warning

# 集合運算式：陣列、空集合與 Create 類寫法改用 [...] 明顯更簡潔，建置時強制
dotnet_style_prefer_collection_expression = when_types_loosely_match
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0302.severity = warning
dotnet_diagnostic.IDE0303.severity = warning
# IDE0305 會把 x.Where(...).ToList() 改成 [.. x.Where(...)]，長串 LINQ 可讀性較差，只在 IDE 提示
dotnet_diagnostic.IDE0305.severity = suggestion
# 集合初始化（IDE0028）不提示
dotnet_diagnostic.IDE0028.severity = none

# 簡化 using 陳述式
csharp_prefer_simple_using_statement = true
dotnet_diagnostic.IDE0063.severity = warning

# 模式比對
csharp_style_pattern_matching_over_as_with_null_check = true
csharp_style_pattern_matching_over_is_with_cast_check = true
csharp_style_prefer_not_pattern = true
csharp_style_prefer_extended_property_pattern = true
dotnet_diagnostic.IDE0019.severity = warning
dotnet_diagnostic.IDE0020.severity = warning
dotnet_diagnostic.IDE0083.severity = warning
dotnet_diagnostic.IDE0170.severity = warning

# switch 運算式
csharp_style_prefer_switch_expression = true
dotnet_diagnostic.IDE0066.severity = warning

# null 合併與 null 條件運算子
dotnet_style_coalesce_expression = true
dotnet_style_null_propagation = true
# ?? 與 ?. 會略過 UnityEngine.Object 覆寫的 == null，對已銷毀的 Unity 物件結果不同，因此不主動要求改寫
dotnet_diagnostic.IDE0029.severity = none
dotnet_diagnostic.IDE0030.severity = warning
dotnet_diagnostic.IDE0031.severity = none
dotnet_diagnostic.IDE0270.severity = none

# 停用 primary constructor，避免改變公開型別與反射契約
csharp_style_prefer_primary_constructors = false
dotnet_diagnostic.IDE0290.severity = none

#### 命名 ####
# 私有欄位使用 _camelCase 前綴
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

#### 第三方分析器 ####
# S101（型別應為 PascalCase）：RimLLM 是品牌名稱，改成 RimLlm* 會破壞公開 API 與下游 Mod 相容性
dotnet_diagnostic.S101.severity = none

# Meziantou.Analyzer：只關掉純風格或與既有慣例衝突的規則，其餘維持預設
# MA0006（== 改 string.Equals）：對 string 而言 == 本來就是序數比較，改寫只增加雜訊
dotnet_diagnostic.MA0006.severity = none
# MA0007（多行初始化最後一項加逗號）：純排版，不影響行為
dotnet_diagnostic.MA0007.severity = none
# MA0048（檔名須等於型別名）：與 partial 拆檔（Type.Part.cs）及小型別共檔的慣例衝突
dotnet_diagnostic.MA0048.severity = none
# MA0016（參數改用集合抽象型別）：改寫會變動框架公開 API，破壞下游 Mod
dotnet_diagnostic.MA0016.severity = none
# MA0051（方法過長）：只作參考
dotnet_diagnostic.MA0051.severity = suggestion
# MA0023（Regex 改用 ExplicitCapture）：微幅效能，且可能影響依編號取群組的程式碼，只作參考
dotnet_diagnostic.MA0023.severity = suggestion
# MA0008（加 StructLayout）、MA0046（事件委派須為 (sender, e)）、MA0096／MA0097（IComparable 配套成員）：
# 對本專案的值型別、既有公開事件與私有排序型別沒有實益
dotnet_diagnostic.MA0008.severity = none
dotnet_diagnostic.MA0046.severity = none
dotnet_diagnostic.MA0096.severity = none
dotnet_diagnostic.MA0097.severity = none

# 兩套分析器重複的規則只保留一條，避免同一處報兩次
# 鎖改用 System.Threading.Lock：保留 MA0158，關閉 S9422
dotnet_diagnostic.S9422.severity = none
# 區域變數遮蔽欄位：保留 MA0084，關閉 S1117
dotnet_diagnostic.S1117.severity = none
# 例外的參數名稱：保留 S3928；MA0015 會誤報 ThrowIfNull(解構出的區域變數)
dotnet_diagnostic.MA0015.severity = none
# async 委派變成 async void：保留 MA0147，關閉 VSTHRD101
dotnet_diagnostic.VSTHRD101.severity = none
# 未觀察的 Task 結果：保留 MA0134，關閉 VSTHRD110
dotnet_diagnostic.VSTHRD110.severity = none
# 泛型型別的靜態成員：MA0018 已棄用並由 CA1000 取代，跟著 CA1000 的決定關閉（見下方）
dotnet_diagnostic.MA0018.severity = none

# Microsoft.VisualStudio.Threading.Analyzers：只留通用的同步阻塞與 async void 規則
# （VSTHRD002 同步等待、VSTHRD100 async void 方法、VSTHRD103 async 方法內呼叫同步版本、VSTHRD114 回傳 null Task）
# VSTHRD003 假設使用 Visual Studio 的 JoinableTaskFactory，本專案沒有
dotnet_diagnostic.VSTHRD003.severity = none
# VSTHRD200（Async 字尾）：純命名風格，且既有公開 API 不能改名
dotnet_diagnostic.VSTHRD200.severity = none

# .NET 內建分析器（AnalysisMode = Recommended）：關閉與 RimWorld 慣例或既有公開 API 衝突的規則
# CA1707（名稱不可含底線）：RimWorld 慣例的 Dialog_／Window_／MainButtonWorker_ 前綴，與 RimLLM_Framework 命名空間
dotnet_diagnostic.CA1707.severity = none
# CA1051（不可公開執行個體欄位）：RimWorld 的 Def 與 Scribe 存檔需要公開欄位
dotnet_diagnostic.CA1051.severity = none
# CA1805（不要明確初始化為預設值）：設定欄位明確寫出預設值，方便對照 Scribe_Values.Look 的預設
dotnet_diagnostic.CA1805.severity = none
# CA1001（擁有可處置欄位的型別須可處置）：GameComponent、Window 由 RimWorld 管理生命週期，
# ColonyAgentSession 則刻意不實作 IDisposable（理由見該型別註解），可處置欄位都在各自的收尾流程釋放
dotnet_diagnostic.CA1001.severity = none
# CA1716（識別碼與關鍵字衝突）：Mod 命名空間屬於已發佈的公開 API
dotnet_diagnostic.CA1716.severity = none
# CA1000（泛型型別的靜態成員）：Result<T>.Ok／Fail 是慣用的工廠寫法
dotnet_diagnostic.CA1000.severity = none
# CA1711（型別名稱字尾）：WorkUndoStack 確實是堆疊語意
dotnet_diagnostic.CA1711.severity = none

# RS0041（公開 API 使用未標註可為 null 的型別）：新檔案一律啟用可為 null 標註，維持 warning，
# 避免新增的程式碼沿用未標註的公開型別（既有檔案的 #nullable disable 另行逐步遷移）
dotnet_diagnostic.RS0041.severity = warning

[**/*Tests*/**.cs]
# 測試程式碼允許行內陣列常數，不強制抽為靜態唯讀欄位，確保測試的局部可讀性
dotnet_diagnostic.CA1861.severity = none
# xUnit 建議測試不加 ConfigureAwait(false)
dotnet_diagnostic.MA0004.severity = none
# 測試資料固定且不受玩家語系影響，不強制指定比較子與文化資訊
dotnet_diagnostic.MA0002.severity = none
dotnet_diagnostic.MA0011.severity = none
dotnet_diagnostic.MA0074.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1310.severity = none
# 測試可直接丟出 Exception 模擬任意失敗
dotnet_diagnostic.CA2201.severity = none
# 測試與實驗程式碼的格式化只跑少數幾次，快取 CompositeFormat 沒有實益
dotnet_diagnostic.CA1863.severity = none
# 測試的 Regex 樣式固定且不處理外部輸入
dotnet_diagnostic.MA0009.severity = none
# 測試方法以「準備、執行、驗證」順序呈現，長度與巢狀區塊有助閱讀
dotnet_diagnostic.MA0051.severity = none
dotnet_diagnostic.S1199.severity = none
# 斷言中以 First()／Last() 表達意圖，比索引更易讀
dotnet_diagnostic.S6608.severity = none
# 測試替身的成員常只供序列化或反射讀取，靜態分析看不到這些用途
dotnet_diagnostic.S1144.severity = none
dotnet_diagnostic.S4487.severity = none
# 清理用的空 catch 與只為耗盡串流的空迴圈是測試常見寫法
dotnet_diagnostic.S108.severity = none
# 同步走訪 IAsyncEnumerator 時 MoveNextAsync().AsTask() 只取用一次，屬誤報
dotnet_diagnostic.S5034.severity = none
# 測試需要 Cancel() 同步執行取消回呼，結果才有確定性，不改用 CancelAsync()
dotnet_diagnostic.S6966.severity = none
dotnet_diagnostic.VSTHRD103.severity = none
# 同步測試方法以 GetAwaiter().GetResult() 等待結果，測試執行緒沒有同步內容，不會死結
dotnet_diagnostic.VSTHRD002.severity = none
# 測試會刻意以任意參數名稱建立例外，驗證錯誤分類
dotnet_diagnostic.S3928.severity = none
