<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RimAgent</AssemblyName>
    <RootNamespace>RimAgent</RootNamespace>
    <Deterministic>true</Deterministic>
    <Authors>mushroomTW</Authors>
    <!-- AssemblyInfo.cs 手寫（InternalsVisibleTo 給測試專案），避免與自動產生的屬性重複。 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Release 才寫入出貨的 Assemblies/；Debug 與 dotnet test 走 bin/，不會蓋掉出貨 DLL。 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <OutputPath Condition="'$(Configuration)' == 'Release'">..\..\Assemblies\</OutputPath>
    <OutputPath Condition="'$(Configuration)' != 'Release'">bin\$(Configuration)\</OutputPath>
    <DebugSymbols Condition="'$(Configuration)' != 'Release'">true</DebugSymbols>
    <DebugType Condition="'$(Configuration)' != 'Release'">portable</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <!--
      RimAgent 只出貨自己與必要擴充之 DLL。MEAI 與其相依全部由 RimLLM Framework 的 Assemblies/ 提供，
      與框架共用相同的 MEAI 組件身分，避免重複載入造成 IChatClient 型別不相容。
      因此絕不開 CopyLocalLockFileAssemblies，套件一律 ExcludeAssets="runtime"。
    -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- 使用 BannedSymbols.txt 禁用的 API 直接編譯失敗。 -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>

  <!-- RimWorld API 改用 Krafs.Rimworld.Ref (1.7.4982-unstable) 提供的參考組件；Harmony 3.0 仍直接參考 Workshop DLL。 -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- RimLLM Framework 組件參考（由框架出貨，Private=false 不複製） -->
  <ItemGroup>
    <Reference Include="RimLLM Framework">
      <HintPath>$(RimLLMDir)RimLLM Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.AI">
      <HintPath>$(RimLLMDir)Microsoft.Extensions.AI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.AI.Abstractions">
      <HintPath>$(RimLLMDir)Microsoft.Extensions.AI.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 決策模型 SDK（TypeSafe System One / TypeSafeAI），隨框架出貨；型別只用在方法內，不進欄位。 -->
    <Reference Include="TypeSafeAI">
      <HintPath>$(RimLLMDir)TypeSafeAI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- SmashTools 編譯期參考（由 RimAgent 隨 Mod 出貨，bundled DLL） -->
  <ItemGroup>
    <Reference Include="CoreLib">
      <HintPath>$(SmashToolsDir)CoreLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SmashTools">
      <HintPath>$(SmashToolsDir)SmashTools.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft Agent Framework：只用 ChatClientAgent 置換工具迴圈，不碰 Workflows。 -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.28.0" ExcludeAssets="runtime" />
    <!-- MEAI 版本跟框架出貨的 DLL 一致；Agent Framework 只間接要求較舊的版本，編譯時會與框架衝突（CS1705）。 -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" ExcludeAssets="runtime" />
    <!-- RimWorld 參考組件（Krafs.Rimworld.Ref）：提供 Assembly-CSharp/UnityStubs/Waylith/ObjectPool 等編譯參考，執行期由遊戲提供。 -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4982-unstable" ExcludeAssets="runtime" />
    <!-- 官方 MCP SDK（stdio client）：遊戲內 agent 呼叫本機 MCP 伺服器。執行期 DLL 見下方出貨白名單。 -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.4.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- SDK 優先的編譯期守門：禁止繞過框架與 SDK 的底層 API，清單與理由見 BannedSymbols.txt。僅建置時使用，不隨 Mod 出貨。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <!--
    必要組件複製到輸出目錄：
    Agent Framework 與 MCP SDK 以及 SmashTools 的 bundled DLL 由 RimAgent 出貨。
    已由遊戲根目錄（System.*, ObjectPool, Bcl.Memory, Immutable）或框架（MEAI, STJ, Channels, Logging）
    提供者一律不複製，確保單一 provider。
    .NET 10 / CoreCLR 環境採用 net10.0 / net8.0 / net5.0 相容資產。
    Release 寫入 Assemblies/（出貨），Debug 寫入 bin/（測試與本機建置用）。
  -->
  <!--
    出貨規則守門（AGENTS.md「與套件的摩擦」）：
    1. 單一來源：套件的執行期組件一律不複製，由遊戲、框架或下方白名單提供。
    2. MEAI 套件版本必須等於框架出貨的 DLL 版本；較新會在執行期找不到方法，較舊會 CS1705。
  -->
  <Target Name="CheckShippingRules" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_PackageWithRuntimeAssets Include="@(PackageReference)"
                                 Condition="!$([System.String]::Copy('%(PackageReference.ExcludeAssets)').ToLowerInvariant().Contains('runtime')) and !$([System.String]::Copy('%(PackageReference.ExcludeAssets)').ToLowerInvariant().Contains('all'))" />
    </ItemGroup>
    <Error Condition="'@(_PackageWithRuntimeAssets)' != ''"
           Text="PackageReference without ExcludeAssets=&quot;runtime&quot;: @(_PackageWithRuntimeAssets). RimAgent must not ship package DLLs that the game or RimLLM Framework already provide; add ExcludeAssets=&quot;runtime&quot; and, if RimAgent really ships it, add the DLL to CopyAgentFrameworkAssemblies." />
    <Error Condition="'$(CopyLocalLockFileAssemblies)' == 'true'"
           Text="CopyLocalLockFileAssemblies must stay false: loading a second copy of MEAI makes IChatClient types incompatible with RimLLM Framework." />
    <Error Condition="!Exists('$(RimLLMDir)Microsoft.Extensions.AI.dll')"
           Text="RimLLM Framework's Microsoft.Extensions.AI.dll was not found at $(RimLLMDir). Install or build RimLLM Framework first; RimAgent compiles against the DLL it ships." />
    <GetAssemblyIdentity AssemblyFiles="$(RimLLMDir)Microsoft.Extensions.AI.dll">
      <Output TaskParameter="Assemblies" ItemName="_FrameworkMeaiIdentity" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <_MeaiPackageVersion>@(PackageReference->WithMetadataValue('Identity', 'Microsoft.Extensions.AI')->'%(Version)')</_MeaiPackageVersion>
      <_FrameworkMeaiVersion>@(_FrameworkMeaiIdentity->'%(Version)')</_FrameworkMeaiVersion>
      <!-- 套件版本可能帶預覽後綴；組件版本是四段，只比前三段。 -->
      <_MeaiPackageCore>$(_MeaiPackageVersion.Split('-')[0])</_MeaiPackageCore>
      <_MeaiPackageCore>$([System.Version]::Parse($(_MeaiPackageCore)).ToString(3))</_MeaiPackageCore>
      <_FrameworkMeaiCore>$([System.Version]::Parse($(_FrameworkMeaiVersion)).ToString(3))</_FrameworkMeaiCore>
    </PropertyGroup>
    <Error Condition="'$(_MeaiPackageCore)' != '$(_FrameworkMeaiCore)'"
           Text="Microsoft.Extensions.AI PackageReference is $(_MeaiPackageVersion) but RimLLM Framework ships $(_FrameworkMeaiVersion). Set the PackageReference to the framework's version, then re-check Microsoft.Agents.AI / ModelContextProtocol.Core dependencies (see AGENTS.md)." />
  </Target>

  <Target Name="CopyAgentFrameworkAssemblies" AfterTargets="Build">
    <ItemGroup>
      <BundledAssemblies Include="$(NuGetPackageRoot)microsoft.agents.ai\1.28.0\lib\net10.0\Microsoft.Agents.AI.dll" />
      <BundledAssemblies Include="$(NuGetPackageRoot)microsoft.agents.ai.abstractions\1.28.0\lib\net10.0\Microsoft.Agents.AI.Abstractions.dll" />
      <!-- .NET 10 版 Agent Framework 的公開型別繼承 EvaluationResult，遊戲掃描型別時就需要此組件。 -->
      <BundledAssemblies Include="$(NuGetPackageRoot)microsoft.extensions.ai.evaluation\10.11.0\lib\net10.0\Microsoft.Extensions.AI.Evaluation.dll" />
      <BundledAssemblies Include="$(NuGetPackageRoot)microsoft.extensions.compliance.abstractions\10.10.0\lib\net10.0\Microsoft.Extensions.Compliance.Abstractions.dll" />
      <BundledAssemblies Include="$(NuGetPackageRoot)microsoft.extensions.vectordata.abstractions\10.10.0\lib\net10.0\Microsoft.Extensions.VectorData.Abstractions.dll" />
      <BundledAssemblies Include="$(NuGetPackageRoot)microsoft.extensions.filesystemglobbing\10.0.12\lib\net10.0\Microsoft.Extensions.FileSystemGlobbing.dll" />
      <BundledAssemblies Include="$(NuGetPackageRoot)microsoft.ml.tokenizers\2.0.0\lib\net8.0\Microsoft.ML.Tokenizers.dll" />
      <BundledAssemblies Include="$(NuGetPackageRoot)google.protobuf\3.30.2\lib\net5.0\Google.Protobuf.dll" />
      <BundledAssemblies Include="$(NuGetPackageRoot)modelcontextprotocol.core\2.4.0\lib\net10.0\ModelContextProtocol.Core.dll" />
      <!-- SmashTools bundled DLLs -->
      <BundledAssemblies Include="$(SmashToolsDir)SmashTools.dll" />
      <BundledAssemblies Include="$(SmashToolsDir)CoreLib.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(BundledAssemblies)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- 排除無法在離線單元測試中直接執行的 RimWorld / Unity GUI 與遊戲世界轉接層 -->
    <SonarQubeSetting Include="sonar.coverage.exclusions">
      <Value>**/UI/**,**/Game/RimWorldGameWorld.cs,**/RimAgentMod.cs,**/RimAgentGameComponent.cs</Value>
    </SonarQubeSetting>
  </ItemGroup>
</Project>
