<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RimAgent</AssemblyName>
    <RootNamespace>RimAgent</RootNamespace>
    <Deterministic>true</Deterministic>
    <Authors>mushroomTW</Authors>
    <!-- AssemblyInfo.cs 手寫（InternalsVisibleTo 給測試專案），避免與自動產生的屬性重複。 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Release 才寫入出貨的 Assemblies/；Debug 與 dotnet test 走 bin/，不會蓋掉出貨 DLL。 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <OutputPath Condition="'$(Configuration)' == 'Release'">..\..\Assemblies\</OutputPath>
    <OutputPath Condition="'$(Configuration)' != 'Release'">bin\$(Configuration)\</OutputPath>
    <DebugSymbols Condition="'$(Configuration)' != 'Release'">true</DebugSymbols>
    <DebugType Condition="'$(Configuration)' != 'Release'">portable</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <!--
      RimAgent 只出貨自己與必要擴充之 DLL。MEAI 與其相依全部由 RimLLM Framework 的 Assemblies/ 提供，
      與框架共用相同的 MEAI 組件身分，避免重複載入造成 IChatClient 型別不相容。
      因此絕不開 CopyLocalLockFileAssemblies，套件一律 ExcludeAssets="runtime"。
    -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- RimWorld API 改用 Krafs.Rimworld.Ref (1.7.4982-unstable) 提供的參考組件；Harmony 3.0 仍直接參考 Workshop DLL。 -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- RimLLM Framework 組件參考（由框架出貨，Private=false 不複製） -->
  <ItemGroup>
    <Reference Include="RimLLM Framework">
      <HintPath>$(RimLLMDir)RimLLM Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.AI">
      <HintPath>$(RimLLMDir)Microsoft.Extensions.AI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.AI.Abstractions">
      <HintPath>$(RimLLMDir)Microsoft.Extensions.AI.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 決策模型 SDK（TypeSafe System One / Jev），隨框架出貨；型別只用在方法內，不進欄位。 -->
    <Reference Include="Kkdev92.Jev">
      <HintPath>$(RimLLMDir)Kkdev92.Jev.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- SmashTools 編譯期參考（由 RimAgent 隨 Mod 出貨，bundled DLL） -->
  <ItemGroup>
    <Reference Include="CoreLib">
      <HintPath>$(SmashToolsDir)CoreLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SmashTools">
      <HintPath>$(SmashToolsDir)SmashTools.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft Agent Framework：只用 ChatClientAgent 置換工具迴圈，不碰 Workflows。 -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.21.0" ExcludeAssets="runtime" />
    <!-- RimWorld 參考組件（Krafs.Rimworld.Ref）：提供 Assembly-CSharp/UnityStubs/Waylith/ObjectPool 等編譯參考，執行期由遊戲提供。 -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4982-unstable" />
    <!-- 官方 MCP SDK（stdio client）：遊戲內 agent 呼叫本機 MCP 伺服器。執行期 DLL 見下方出貨白名單。 -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!--
    必要組件複製到輸出目錄：
    Agent Framework 與 MCP SDK 以及 SmashTools 的 bundled DLL 由 RimAgent 出貨。
    已由遊戲根目錄（System.*, ObjectPool, Bcl.Memory, Immutable）或框架（MEAI, STJ, Channels, Logging）
    提供者一律不複製，確保單一 provider。
    .NET 10 / CoreCLR 環境採用 net10.0 / net8.0 / net5.0 相容資產。
    Release 寫入 Assemblies/（出貨），Debug 寫入 bin/（測試與本機建置用）。
  -->
  <Target Name="CopyAgentFrameworkAssemblies" AfterTargets="Build">
    <ItemGroup>
      <BundledAssemblies Include="$(NuGetPackageRoot)microsoft.agents.ai\1.21.0\lib\net10.0\Microsoft.Agents.AI.dll" />
      <BundledAssemblies Include="$(NuGetPackageRoot)microsoft.agents.ai.abstractions\1.21.0\lib\net10.0\Microsoft.Agents.AI.Abstractions.dll" />
      <!-- .NET 10 版 Agent Framework 的公開型別繼承 EvaluationResult，遊戲掃描型別時就需要此組件。 -->
      <BundledAssemblies Include="$(NuGetPackageRoot)microsoft.extensions.ai.evaluation\10.10.0\lib\net10.0\Microsoft.Extensions.AI.Evaluation.dll" />
      <BundledAssemblies Include="$(NuGetPackageRoot)microsoft.extensions.compliance.abstractions\10.10.0\lib\net10.0\Microsoft.Extensions.Compliance.Abstractions.dll" />
      <BundledAssemblies Include="$(NuGetPackageRoot)microsoft.extensions.vectordata.abstractions\10.10.0\lib\net10.0\Microsoft.Extensions.VectorData.Abstractions.dll" />
      <BundledAssemblies Include="$(NuGetPackageRoot)microsoft.extensions.filesystemglobbing\10.0.12\lib\net10.0\Microsoft.Extensions.FileSystemGlobbing.dll" />
      <BundledAssemblies Include="$(NuGetPackageRoot)microsoft.ml.tokenizers\2.0.0\lib\net8.0\Microsoft.ML.Tokenizers.dll" />
      <BundledAssemblies Include="$(NuGetPackageRoot)google.protobuf\3.30.2\lib\net5.0\Google.Protobuf.dll" />
      <BundledAssemblies Include="$(NuGetPackageRoot)modelcontextprotocol.core\2.2.0\lib\net10.0\ModelContextProtocol.Core.dll" />
      <!-- SmashTools bundled DLLs -->
      <BundledAssemblies Include="$(SmashToolsDir)SmashTools.dll" />
      <BundledAssemblies Include="$(SmashToolsDir)CoreLib.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(BundledAssemblies)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- 排除無法在離線單元測試中直接執行的 RimWorld / Unity GUI 與遊戲世界轉接層 -->
    <SonarQubeSetting Include="sonar.coverage.exclusions">
      <Value>**/UI/**,**/Game/RimWorldGameWorld.cs,**/RimAgentMod.cs,**/RimAgentGameComponent.cs</Value>
    </SonarQubeSetting>
  </ItemGroup>
</Project>
