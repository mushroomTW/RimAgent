<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>RimAgent.Tests</RootNamespace>
    <AssemblyName>RimAgent.Tests</AssemblyName>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.21.0" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.12" ExcludeAssets="all" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RimAgent\RimAgent.csproj" />
  </ItemGroup>

  <!-- 1.7 的遊戲組件、Harmony 3.0、框架組件與 SmashTools：直接參考並複製到測試輸出，執行期才找得到。 -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.ObjectPool">
      <HintPath>$(RimWorldDir)Microsoft.Extensions.ObjectPool.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)Assembly-CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)Waylith.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="RimLLM Framework">
      <HintPath>$(RimLLMDir)RimLLM Framework.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.AI">
      <HintPath>$(RimLLMDir)Microsoft.Extensions.AI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.AI.Abstractions">
      <HintPath>$(RimLLMDir)Microsoft.Extensions.AI.Abstractions.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="CoreLib">
      <HintPath>$(SmashToolsDir)CoreLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SmashTools">
      <HintPath>$(SmashToolsDir)SmashTools.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
