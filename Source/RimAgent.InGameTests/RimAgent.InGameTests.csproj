<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RimAgent 的遊戲內整合測試（SmashPhil DevTools）。只供開發伴隨模組使用，不隨正式 mod 出貨。
    輸出到 Mod/Assemblies/，由遊戲內 DevTools 執行器載入。
    透過 ProjectReference 保證先建置主模組；執行遊戲前請以 Release 建置，更新正式載入的 Assemblies/。
  -->
  <PropertyGroup>
    <AssemblyName>RimAgent.InGameTests</AssemblyName>
    <RootNamespace>RimAgent.InGameTests</RootNamespace>
    <OutputPath>Mod\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Mod\**" />
    <None Remove="Mod\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DevTools">
      <HintPath>$(DevToolsDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimLLM Framework">
      <HintPath>$(RimLLMDir)RimLLM Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.AI.Abstractions">
      <HintPath>$(RimLLMDir)Microsoft.Extensions.AI.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CoreLib">
      <HintPath>$(SmashToolsDir)CoreLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SmashTools">
      <HintPath>$(SmashToolsDir)SmashTools.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <ProjectReference Include="..\RimAgent\RimAgent.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CheckDevTools" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(DevToolsDll)')"
           Text="DevTools 1.7 DLL not found at '$(DevToolsDll)'. Pass -p:DevToolsDll=&lt;path to DevTools.dll&gt;" />
  </Target>

  <Target Name="CopyDevToolsForDevelopment" AfterTargets="Build">
    <Copy SourceFiles="$(DevToolsDll)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
